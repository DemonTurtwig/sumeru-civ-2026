<?xml version="1.0" encoding="utf-8"?>
<Mod id="df03a254-4041-4d7f-b44a-94a89747e4a2" version="2">
  <Properties>
    <Name>Nahida of Sumeru</Name>
    <Description>Step into the mystical lands of Sumeru, where the brilliant Nahida, the Dendro Archon, leads her people with wisdom, faith, and an unwavering connection to nature. In this mod, experience a truly unique civilization that harnesses the power of faith to control all aspects of its development, while utilizing the magical Aranara as both protectors and spiritual guides.</Description>
    <Created>1775740959</Created>
    <Teaser>Play as Nahida in Civilization VI!</Teaser>
    <Authors>최초의 쌀숭이</Authors>
    <SpecialThanks>HOYOVERSE, CivFanatics</SpecialThanks>
    <Homepage>http://https://steamcommunity.com/profiles/76561198114710758/</Homepage>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
